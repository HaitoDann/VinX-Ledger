    "summary": "Frais conseillés",
    "description": "Frais minimum et frais conseillés selon l'encombrement.",
    "parameters": [],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "min_fee": {
           "type": "string",
           "example": "1000000",
           "description": "Montant en unités, sous forme de texte (1 VINX = 1 000 000 000 unités)."
          },
          "recommended_fee": {
           "type": "string",
           "example": "1000000",
           "description": "Montant en unités, sous forme de texte (1 VINX = 1 000 000 000 unités)."
          },
          "pending_transactions": {
           "type": "integer",
           "example": 0
          },
          "max_block_txs": {
           "type": "integer",
           "example": 5000
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/validators": {
   "get": {
    "tags": [
     "Réseau"
    ],
    "summary": "Validateurs",
    "description": "Présence et activité de chaque validateur.",
    "parameters": [],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "window_blocks": {
           "type": "integer",
           "example": 11
          },
          "validators": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "index": {
              "type": "integer",
              "example": 0
             },
             "key": {
              "type": "string",
              "example": "013e…"
             },
             "name": {
              "type": "string",
              "example": "Cinnamon",
              "nullable": true
             },
             "presence": {
              "type": "string",
              "example": "en ligne"
             },
             "signed": {
              "type": "integer",
              "example": 11
             },
             "last_signed_height": {
              "type": "integer",
              "example": 11
             }
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/governance": {
   "get": {
    "tags": [
     "Réseau"
    ],
    "summary": "Gouvernance",
    "description": "Signataires admin, paramètres, émission, escrow, trésorerie et mise à jour du protocole programmée (`upgrade`).",
    "parameters": [],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "protocol_version": {
           "type": "integer",
           "example": 6
          },
          "upgrade": {
           "type": "object",
           "properties": {
            "version": {
             "type": "integer",
             "example": 7
            },
            "activation_height": {
             "type": "integer",
             "example": 123456
            }
           },
           "description": "Mise à jour programmée, ou `null`."
          },
          "params": {
           "type": "object",
           "properties": {}
          },
          "treasury": {
           "type": "object",
           "properties": {
            "address": {
             "type": "string",
             "example": "vinx1z6gt9tr9v7m9vj2lt9rvrmjxc7sa2g9d0fx633",
             "description": "Adresse bech32 `vinx1…`."
            },
            "balance": {
             "type": "string",
             "example": "999110000000000",
             "description": "Montant en unités, sous forme de texte (1 VINX = 1 000 000 000 unités)."
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/accounts/{address}": {
   "get": {
    "tags": [
     "Comptes et noms"
    ],
    "summary": "Compte",
    "description": "Solde, part dépensable, réserve, nonce, jetons détenus, mandats et séquestres d'une adresse. Avant d'envoyer, utilisez `nonce + 1` (ajoutez vos transactions encore en attente).",
    "parameters": [
     {
      "name": "address",
      "in": "path",
      "description": "Adresse `vinx1…`.",
      "required": true,
      "schema": {
       "type": "string",
       "example": "vinx1cdlrapuw5z6cc5j3wx9xgmutd4056aazrq6f3f"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "address": {
           "type": "string",
           "example": "vinx1cdlrapuw5z6cc5j3wx9xgmutd4056aazrq6f3f",
           "description": "Adresse bech32 `vinx1…`."
          },
          "balance": {
           "type": "string",
           "example": "4999000000",
           "description": "Montant en unités, sous forme de texte (1 VINX = 1 000 000 000 unités)."
          },
          "spendable": {
           "type": "string",
           "example": "4799000000",
           "description": "Solde moins la réserve."
          },
          "reserve": {
           "type": "string",
           "example": "200000000",
           "description": "Réserve du compte plus 0,1 VINX par objet (protocole 6)."
          },
          "objects": {
           "type": "integer",
           "example": 1,
           "description": "Jetons acceptés, mandats et règles de compte."
          },
          "nonce": {
           "type": "integer",
           "example": 1
          },
          "public_key": {
           "type": "string",
           "example": "0100…",
           "nullable": true,
           "description": "`null` tant que le compte n'a rien envoyé : joindre alors la clé publique à la première transaction."
          },
          "memo_required": {
           "type": "boolean",
           "example": false
          },
          "names": {
           "type": "array",
           "items": {
            "type": "string",
            "example": "boutique.vinx"
           }
          },
          "assets": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "symbol": {
              "type": "string",
              "example": "DEMO"
             },
             "name": {
              "type": "string",
              "example": "Jeton démo"
             },
             "decimals": {
              "type": "integer",
              "example": 2
             },
             "units": {
              "type": "string",
              "example": "1250"
             },
             "frozen": {
              "type": "boolean",
              "example": false
             }
            }
           }
          },
          "policy": {
           "type": "object",
           "properties": {},
           "description": "Règles du compte (multisignature, plafond), ou `null`."
          },
          "mandates": {
           "type": "object",
           "properties": {
            "granted": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            },
            "received": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            }
           }
          },
          "deals": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {}
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Erreur",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/accounts/{address}/transactions": {
   "get": {
    "tags": [
     "Comptes et noms"
    ],
    "summary": "Historique d'une adresse",
    "description": "Transactions en attente puis finalisées, de la plus récente à la plus ancienne. Un nœud ordinaire ne garde que 24 heures de blocs : interrogez un nœud archive pour tout l'historique.",
    "parameters": [
     {
      "name": "address",
      "in": "path",
      "description": "Adresse `vinx1…`.",
      "required": true,
      "schema": {
       "type": "string",
       "example": "vinx1cdlrapuw5z6cc5j3wx9xgmutd4056aazrq6f3f"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "description": "Nombre d'entrées, 50 par défaut, 200 au plus.",
      "required": false,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "transactions": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Transaction"
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Erreur",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/names/{name}": {
   "get": {
    "tags": [
     "Comptes et noms"
    ],
    "summary": "Nom .vinx",
    "description": "Titulaire, échéance (secondes Unix) et prix d'un nom ; `available` indique s'il peut être enregistré.",
    "parameters": [
     {
      "name": "name",
      "in": "path",
      "description": "Nom, avec ou sans `.vinx`.",
      "required": true,
      "schema": {
       "type": "string",
       "example": "demo"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "name": {
           "type": "string",
           "example": "demo.vinx"
          },
          "owner": {
           "type": "string",
           "example": "vinx1z6gt9tr9v7m9vj2lt9rvrmjxc7sa2g9d0fx633",
           "description": "Adresse bech32 `vinx1…`."
          },
          "expires_at": {
           "type": "integer",
           "example": 1825024294
          },
          "available": {
           "type": "boolean",
           "example": false
          },
          "active": {
           "type": "boolean",
           "example": true
          },
          "fee": {
           "type": "string",
           "example": "10000000000",
           "description": "Montant en unités, sous forme de texte (1 VINX = 1 000 000 000 unités)."
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Erreur",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/assets": {
   "get": {
    "tags": [
     "Jetons"
    ],
    "summary": "Tous les jetons",
    "description": "Liste des actifs natifs, avec leur nombre de détenteurs (`holders`, soldes non nuls), et prix de création (`fee`).",
    "parameters": [],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "active": {
           "type": "boolean",
           "example": true,
           "description": "Actifs disponibles (protocole 5 ou plus)."
          },
          "fee": {
           "type": "string",
           "example": "100000000000",
           "description": "Montant en unités, sous forme de texte (1 VINX = 1 000 000 000 unités)."
          },
          "assets": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Asset"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/assets/{symbol}": {
   "get": {
    "tags": [
     "Jetons"
    ],
    "summary": "Un jeton",
    "description": "Émetteur, supply, décimales, pouvoirs restants et nombre de détenteurs (solde non nul).",
    "parameters": [
     {
      "name": "symbol",
      "in": "path",
      "description": "Symbole, insensible à la casse.",
      "required": true,
      "schema": {
       "type": "string",
       "example": "DEMO"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "symbol": {
           "type": "string",
           "example": "DEMO"
          },
          "name": {
           "type": "string",
           "example": "Jeton démo"
          },
          "issuer": {
           "type": "string",
           "example": "vinx1z6gt9tr9v7m9vj2lt9rvrmjxc7sa2g9d0fx633",
           "description": "Adresse bech32 `vinx1…`."
          },
          "decimals": {
           "type": "integer",
           "example": 2
          },
          "supply_units": {
           "type": "string",
           "example": "10000000",
           "description": "En circulation, en unités de l'actif."
          },
          "max_supply_units": {
           "type": "string",
           "description": "Plafond, ou `null` sans plafond.",
           "nullable": true
          },
          "powers": {
           "type": "object",
           "properties": {
            "mint": {
             "type": "boolean",
             "example": true
            },
            "freeze": {
             "type": "boolean",
             "example": true
            },
            "clawback": {
             "type": "boolean",
             "example": false
            }
           },
           "description": "Pouvoirs que l'émetteur détient encore. Ils ne peuvent qu'être abandonnés."
          },
          "frozen": {
           "type": "boolean",
           "example": false,
           "description": "Tout l'actif est gelé."
          },
          "holders": {
           "type": "integer",
           "example": 2,
           "description": "Comptes au solde non nul."
          }
         }
        }
       }
      }
     },
     "404": {
      "description": "Erreur",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/assets/{symbol}/holders": {
   "get": {
    "tags": [
     "Jetons"
    ],
    "summary": "Détenteurs d'un jeton",
    "description": "Comptes qui ont accepté le jeton, du plus gros solde au plus petit, y compris à solde nul. Pagination par `offset`.",
    "parameters": [
     {
      "name": "symbol",
      "in": "path",
      "description": "Symbole.",
      "required": true,
      "schema": {
       "type": "string",
       "example": "DEMO"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "description": "Nombre d'entrées, 50 par défaut, 200 au plus.",
      "required": false,
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "offset",
      "in": "query",
      "description": "Entrées à sauter, 0 par défaut.",
      "required": false,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "symbol": {
           "type": "string",
           "example": "DEMO"
          },
          "total": {
           "type": "integer",
           "example": 2,
           "description": "Nombre total de lignes."
          },
          "offset": {
           "type": "integer",
           "example": 0
          },
          "holders": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "address": {
              "type": "string",
              "example": "vinx1z6gt9tr9v7m9vj2lt9rvrmjxc7sa2g9d0fx633",
              "description": "Adresse bech32 `vinx1…`."
             },
             "units": {
              "type": "string",
              "example": "9998750"
             },
             "frozen": {
              "type": "boolean",
              "example": false
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "404": {
      "description": "Erreur",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/assets/{symbol}/transactions": {
   "get": {
    "tags": [
     "Jetons"
    ],
    "summary": "Historique d'un jeton",
    "description": "Création, émissions, paiements, acceptations, gels, reprises… du plus récent au plus ancien, dans les blocs conservés. Les versements et remboursements de séquestre (`ReleaseDeal`, `RefundDeal`) n'y figurent pas : ils ne nomment pas l'actif.",
    "parameters": [
     {
      "name": "symbol",
      "in": "path",
      "description": "Symbole.",
      "required": true,
      "schema": {
       "type": "string",
       "example": "DEMO"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "description": "Nombre d'entrées, 20 par défaut, 100 au plus.",
      "required": false,
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "before",
      "in": "query",
      "description": "Seulement sous cette hauteur (page suivante : la plus petite hauteur reçue).",
      "required": false,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Succès",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "symbol": {
