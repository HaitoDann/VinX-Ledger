  "/transactions": {
   "post": {
    "tags": [
     "Envoyer"
    ],
    "summary": "Envoyer une transaction",
    "description": "Corps : `{\"tx\": \"<hex>\"}`, la transaction signée encodée en **Borsh** puis en hexadécimal. Réponse : son identifiant. Elle est refusée (`422`) si la signature, le nonce, les frais, le solde ou la réserve ne conviennent pas ; le message dit pourquoi.\n\nLe format exact (champs, ordre, préfixe de domaine signé) est dans la [spécification](https://github.com/HaitoDann/VinX-Ledger/blob/main/SPEC.md). En pratique, signez avec un outil existant : `vinx-wallet` (ligne de commande) ou le module WebAssembly du portefeuille mobile (`crates/vinx-mobile`).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "tx": {
          "type": "string",
          "example": "0e0000007669…",
          "description": "Transaction signée, Borsh, hexadécimal."
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Acceptée dans la file d'attente",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string",
           "example": "fdeb89a1a90e6541f82eae9409c8cbf4f4ef4433f9cd99ccfadec09f9804be93"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Erreur",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "422": {
      "description": "Erreur",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "description": "Erreur",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string",
      "example": "actif inconnu",
      "description": "Message lisible, en français."
     }
    }
   },
   "Transaction": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "example": "fdeb89a1a90e6541f82eae9409c8cbf4f4ef4433f9cd99ccfadec09f9804be93",
      "description": "Identifiant (BLAKE3, hexadécimal)."
     },
     "kind": {
      "type": "string",
      "example": "paiement en actif",
      "description": "Nature lisible : `paiement`, `paiement groupé`, `nom`, `séquestre`, `création d'actif`, `émission d'actif`, `paiement en actif`, `actif accepté`…"
     },
     "sender": {
      "type": "string",
      "example": "vinx1z6gt9tr9v7m9vj2lt9rvrmjxc7sa2g9d0fx633",
      "description": "Adresse bech32 `vinx1…`."
     },
     "nonce": {
      "type": "integer",
      "example": 4
     },
     "fee": {
      "type": "string",
      "example": "1000000",
      "description": "Montant en unités, sous forme de texte (1 VINX = 1 000 000 000 unités)."
     },
     "to": {
      "type": "string",
      "example": "vinx1cdlrapuw5z6cc5j3wx9xgmutd4056aazrq6f3f",
      "description": "Adresse bech32 `vinx1…`."
     },
     "amount": {
      "type": "string",
      "example": "12500000000",
      "description": "Montant en VINX (unités), pour les paiements en VINX."
     },
     "asset": {
      "type": "string",
      "example": "DEMO",
      "description": "Symbole, pour les opérations sur un actif."
     },
     "units": {
      "type": "string",
      "example": "1250",
      "description": "Montant en unités de l'actif (diviser par 10^décimales)."
     },
     "memo": {
      "type": "string",
      "example": "FAC-1",
      "description": "Mémo en texte, s'il est lisible."
     },
     "memo_hex": {
      "type": "string",
      "example": "4641432d31"
     },
     "height": {
      "type": "integer",
      "example": 11,
      "description": "Bloc qui l'a finalisée."
     },
     "timestamp": {
      "type": "integer",
      "example": 1793466729038,
      "description": "Horodatage du bloc, en millisecondes."
     },
     "status": {
      "type": "string",
      "example": "finalisée",
      "description": "`finalisée` ou `en attente` (historique d'adresse)."
     }
    },
    "description": "Transaction lisible. Les champs présents dépendent de `kind`."
   },
   "Asset": {
    "type": "object",
    "properties": {
     "symbol": {
      "type": "string",
      "example": "DEMO"
     },
     "name": {
      "type": "string",
      "example": "Jeton démo"
     },
     "issuer": {
      "type": "string",
      "example": "vinx1z6gt9tr9v7m9vj2lt9rvrmjxc7sa2g9d0fx633",
      "description": "Adresse bech32 `vinx1…`."
     },
     "decimals": {
      "type": "integer",
      "example": 2
     },
     "supply_units": {
      "type": "string",
      "example": "10000000",
      "description": "En circulation, en unités de l'actif."
     },
     "max_supply_units": {
      "type": "string",
      "description": "Plafond, ou `null` sans plafond.",
      "nullable": true
     },
     "powers": {
      "type": "object",
      "properties": {
       "mint": {
        "type": "boolean",
        "example": true
       },
       "freeze": {
        "type": "boolean",
        "example": true
       },
       "clawback": {
        "type": "boolean",
        "example": false
       }
      },
      "description": "Pouvoirs que l'émetteur détient encore. Ils ne peuvent qu'être abandonnés."
     },
     "frozen": {
      "type": "boolean",
      "example": false,
      "description": "Tout l'actif est gelé."
     }
    }
   },
   "Block": {
    "type": "object",
    "properties": {
     "height": {
      "type": "integer",
      "example": 11
     },
     "hash": {
      "type": "string",
      "example": "0fd0c250…"
     },
     "timestamp": {
      "type": "integer",
      "example": 1793466729038
     },
     "proposer": {
      "type": "integer",
      "example": 0
     },
     "round": {
      "type": "integer",
      "example": 0
     },
     "transactions": {
      "type": "integer",
      "example": 1
     },
     "admin_transactions": {
      "type": "integer",
      "example": 0
     }
    }
   }
  }
 }
}