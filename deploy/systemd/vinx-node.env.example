# Options propres à ce nœud, ajoutées à la ligne de commande de vinx-node.
# Un pair par option --peer (il est alors autorisé d'office) :
VINX_OPTIONS="--peer /ip4/203.0.113.11/tcp/26656/p2p/12D3KooW... --peer /ip4/203.0.113.12/tcp/26656/p2p/12D3KooW... --peer /ip4/203.0.113.13/tcp/26656/p2p/12D3KooW..."
# Pour un nœud archive, ajouter : --archive
# Pour autoriser un observateur sans le joindre : --allow 12D3KooW...
