{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VinX Wallet",
  "version": "0.1.0",
  "identifier": "com.vinxlabs.wallet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VinX Wallet",
        "width": 1060,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
