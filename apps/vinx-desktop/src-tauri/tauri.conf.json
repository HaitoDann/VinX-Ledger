{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VinX",
  "version": "0.2.2",
  "identifier": "com.vinxlabs.wallet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VinX",
        "width": 1060,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vinx-node"
    ],
    "shortDescription": "Portefeuille et validateur VinX",
    "category": "Finance"
  }
}
