#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# VinX — réseau de test à la maison, en une commande.
#
#   ./vinx start            1 validateur + interface web + faucet
#   ./vinx start -n 4       4 validateurs (tolère 1 panne)
#   ./vinx status           hauteur, validateurs, santé
#   ./vinx stop             arrête tout (les données sont conservées)
#   ./vinx start            relance là où on s'était arrêté
#   ./vinx kill 3           arrête le validateur 3 (test de panne)
#   ./vinx revive 3         le relance
#   ./vinx logs [i]         journal du nœud i (1 par défaut)
#   ./vinx wallet <cmd>     vinx-wallet branché sur le nœud local
#   ./vinx load [N]         test de charge : N transferts réels (défaut 500), débit mesuré
#   ./vinx reset            efface le réseau local (nouvelle genèse)
#
# Deux machines (réseau domestique) :
#   PC hôte    : ./vinx start --lan        (--testnet : chaîne de test publique)
#                ./vinx pending            demandes d'admission reçues
#                ./vinx accept <adresse>   finance et admet le nouveau validateur
#   Second PC  : ./vinx join <ip-hôte>     rejoint la chaîne et devient validateur
#   Serveur    : sudo ./vinx service       installe le(s) nœud(s) comme service systemd
#
# Options de start : -n <validateurs> (1–9), -t <temps de bloc en s> (défaut 12, le paramètre du protocole),
#                    --lan (écoute sur le réseau local, pour d'autres machines/téléphones)
# Données : ./.vinx-local/   (ou VINX_HOME)
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
HOME_DIR="${VINX_HOME:-$ROOT/.vinx-local}"
NODE="$ROOT/target/release/vinx-node"
WALLET="$ROOT/target/release/vinx-wallet"
CHAIN_ID=42   # devnet ; 7 avec --testnet (chaîne de test publique)
[[ -f "${VINX_HOME:-$(cd "$(dirname "$0")" && pwd)/.vinx-local}/genesis.json" ]] && \
    CHAIN_ID=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['chain_id'])" \
        "${VINX_HOME:-$(cd "$(dirname "$0")" && pwd)/.vinx-local}/genesis.json" 2>/dev/null || echo 42)

c_ok=$'\e[32m'; c_dim=$'\e[2m'; c_b=$'\e[1m'; c_r=$'\e[31m'; c_0=$'\e[0m'
say()  { echo "${c_b}▸${c_0} $*"; }
ok()   { echo "  ${c_ok}✓${c_0} $*"; }
die()  { echo "  ${c_r}✗ $*${c_0}" >&2; exit 1; }

OFF="${VINX_PORT_OFFSET:-0}"   # pour faire tourner deux « machines » sur un même PC (tests)
rpc_port() { echo $((8544 + $1 + OFF)); }
p2p_port() { echo $((9000 + $1 + OFF)); }
rpc() { curl -s --max-time 2 "http://127.0.0.1:$(rpc_port "$1")/$2" 2>/dev/null || true; }
jget() { python3 -c "import sys,json
try: print(json.load(sys.stdin)$1)
except Exception: print('')"; }
count() { cat "$HOME_DIR/validators" 2>/dev/null || echo 0; }
pid_of() { cat "$HOME_DIR/node$1.pid" 2>/dev/null || true; }
alive() {
    local p; p=$(pid_of "$1")
    { [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; } || \
        { [[ -z "${VINX_PORT_OFFSET:-}" ]] && systemctl is-active --quiet "vinx-node$1" 2>/dev/null; }
}

build() {
    # rustup installs cargo in ~/.cargo/bin, which a shell opened before the install
    # does not have in its PATH yet.
    [[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
    if [[ ! -x "$NODE" || ! -x "$WALLET" || -n "$(find "$ROOT/crates" -newer "$NODE" -name '*.rs' -print -quit 2>/dev/null)" ]]; then
        command -v cargo >/dev/null || die "Rust n'est pas installé : curl https://sh.rustup.rs -sSf | sh   puis ouvrir un nouveau terminal"
        if ! command -v cc >/dev/null; then
            echo "  ${c_r}✗ compilateur C absent (nécessaire à la cryptographie).${c_0}"
            echo "    Debian/Ubuntu : sudo apt install build-essential"
            echo "    Fedora        : sudo dnf install gcc"
            echo "    macOS         : xcode-select --install"
            exit 1
        fi
        say "Compilation (la première fois prend quelques minutes)…"
        local log="$ROOT/.vinx-build.log"
        if ! cargo build --release -p vinx-node -p vinx-wallet --manifest-path "$ROOT/Cargo.toml" >"$log" 2>&1; then
            echo "  ${c_r}✗ la compilation a échoué — fin du journal ($log) :${c_0}"
            grep -E "^error|error:|warning: unused" -A6 "$log" | head -40 || tail -30 "$log"
            exit 1
        fi
    fi
}

init_network() {
    local n="$1" bt="$2"
    say "Création d'un réseau local à $n validateur(s), bloc toutes les ${bt}s"
    mkdir -p "$HOME_DIR"
    local entries=()
    for i in $(seq 1 "$n"); do
        mkdir -p "$HOME_DIR/node$i"
        entries+=("$("$NODE" --data-dir "$HOME_DIR/node$i" --chain-id $CHAIN_ID --genesis-entry 2>/dev/null | grep '^{')")
    done
    local admin
    admin=$(python3 -c "import json;print(json.load(open('$HOME_DIR/node1/admin.json'))['address'])")
    VINX_CHAIN=$CHAIN_ID python3 - "$HOME_DIR/genesis.json" "$admin" "$bt" "${entries[@]}" <<'PY'
import json, sys, time
out, admin, bt, *entries = sys.argv[1:]
e = [json.loads(x) for x in entries]
json.dump({
    "chain_id": int(__import__("os").environ["VINX_CHAIN"]), "genesis_timestamp": int(time.time()) - 60, "admin_address": admin,
    "initial_validator": e[0]["address"],
    "initial_validator_bls_pub_key": e[0]["bls_pub_key"],
    "initial_validator_bls_pop": e[0]["bls_pop"],
    "validators": e[1:], "block_time_secs": int(bt),
    "prefund_initial_validator_vinx": 1000000,
}, open(out, "w"), indent=2)
PY
    # Faucet: node1's validator account holds the dev prefund and hands it out.
    cat >"$HOME_DIR/node1/config.toml" <<EOF
faucet_key_file = "$HOME_DIR/node1/validator.json"
faucet_cooldown_secs = $([[ $CHAIN_ID == 7 ]] && echo 86400 || echo 30)
admin_token = "$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
EOF
    echo "$n" >"$HOME_DIR/validators"
    ok "genèse écrite ($HOME_DIR/genesis.json)"
}

# Ligne de commande complète du nœud i (partagée par start_node et le service systemd).
node_args() {
    local i="$1" host="127.0.0.1" n peers=()
    [[ -f "$HOME_DIR/lan" ]] && host="0.0.0.0"
    n=$(count)
    for j in $(seq 1 "$n"); do [[ $j != "$i" ]] && peers+=("/ip4/127.0.0.1/tcp/$(p2p_port "$j")"); done
    ARGS=()
    [[ -f "$HOME_DIR/node$i/config.toml" ]] && ARGS+=(--config "$HOME_DIR/node$i/config.toml")
    ARGS+=(--data-dir "$HOME_DIR/node$i" --chain-id "$CHAIN_ID"
           --rpc-listen "$host:$(rpc_port "$i")" --p2p-listen "/ip4/$host/tcp/$(p2p_port "$i")")
    if [[ -f "$HOME_DIR/joined" ]]; then    # machine qui a rejoint une chaîne existante
        local remote rp proto=dns4; read -r remote rp <"$HOME_DIR/joined"
        [[ "$remote" =~ ^[0-9.]+$ ]] && proto=ip4
        peers+=("/$proto/$remote/tcp/$((rp - 8545 + 9001))")
        ARGS+=(--sync-peer "http://$remote:$rp")
    fi
    (( ${#peers[@]} )) && ARGS+=(--peers "${peers[@]}")
    return 0
}

start_node() {
    local i="$1"
    alive "$i" && return 0
    node_args "$i"
    VINX_GENESIS_SPEC="$HOME_DIR/genesis.json" nohup "$NODE" "${ARGS[@]}" >>"$HOME_DIR/node$i.log" 2>&1 &
    echo $! >"$HOME_DIR/node$i.pid"
}

wait_up() {
    for _ in $(seq 1 60); do
        [[ "$(rpc 1 health | jget "['status']")" == "ok" ]] && return 0
        sleep 0.5
    done
    die "le nœud 1 ne répond pas — voir ./vinx logs 1"
}

cmd_start() {
    local n=1 bt=12 lan=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n) n="$2"; shift 2 ;;
            -t) bt="$2"; shift 2 ;;
            --lan) lan=1; shift ;;
            --testnet) CHAIN_ID=7; lan=1; shift ;;
            *) die "option inconnue : $1" ;;
        esac
    done
    [[ "$n" =~ ^[1-9]$ ]] || die "-n doit être entre 1 et 9"
    command -v python3 >/dev/null || die "python3 est requis"
    command -v curl >/dev/null || die "curl est requis"
    build
    if [[ -f "$HOME_DIR/genesis.json" ]]; then
        [[ "$n" != 1 && "$n" != "$(count)" ]] && die "réseau existant à $(count) validateur(s) — ./vinx reset pour en changer"
        say "Reprise du réseau local existant ($(count) validateur(s))"
    else
        init_network "$n" "$bt"
    fi
    # Switching between local and --lan changes the listen address: a node already
    # running must be restarted, or it keeps listening on the old one.
    local was=0; [[ -f "$HOME_DIR/lan" ]] && was=1
    if [[ $lan != "$was" ]] && alive 1; then
        say "Redémarrage pour changer l'adresse d'écoute"
        cmd_stop >/dev/null
        for _ in $(seq 1 20); do alive 1 || break; sleep 0.5; done
    fi
    if [[ $lan == 1 ]]; then touch "$HOME_DIR/lan"; else rm -f "$HOME_DIR/lan"; fi
    for i in $(seq 1 "$(count)"); do start_node "$i"; done
    wait_up
    ok "$(count) validateur(s) en marche"
    local ip=127.0.0.1
    if [[ -f "$HOME_DIR/lan" ]]; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
        [[ -z "$ip" ]] && ip=$(ipconfig getifaddr en0 2>/dev/null || echo 127.0.0.1) # macOS
    fi
    echo
    echo "  ${c_b}Interface web :${c_0}  http://$ip:8545/"
    echo "  ${c_dim}→ « Nouveau portefeuille », puis « Faucet » pour recevoir 100 VINX de test.${c_0}"
    echo
    echo "  ./vinx status     état du réseau        ./vinx stop    arrêter"
    echo "  ./vinx kill 2     simuler une panne     ./vinx reset   repartir de zéro"
    [[ "$(count)" -lt 4 ]] && echo "  ${c_dim}Astuce : ./vinx reset && ./vinx start -n 4 pour tester la tolérance aux pannes.${c_0}"
    return 0
}

cmd_status() {
    [[ -f "$HOME_DIR/genesis.json" ]] || die "aucun réseau local — ./vinx start"
    local n; n=$(count)
    echo "${c_b}Réseau local${c_0} — $n validateur(s) sur ce PC, chaîne $CHAIN_ID"
    if [[ -f "$HOME_DIR/joined" ]]; then local r; read -r r _ <"$HOME_DIR/joined"; echo "  ${c_dim}a rejoint la chaîne de l'hôte $r — set complet : $(rpc 1 validators | jget "['count']") validateur(s)${c_0}"; fi
    for i in $(seq 1 "$n"); do
        if alive "$i"; then
            local h; h=$(rpc "$i" health | jget "['height']")
            echo "  nœud $i  ${c_ok}● en marche${c_0}  hauteur ${h:-?}   http://127.0.0.1:$(rpc_port "$i")/"
        else
            echo "  nœud $i  ${c_r}○ arrêté${c_0}"
        fi
    done
    # Quorum du RÉSEAU entier (toutes machines), lu sur la chaîne — pas seulement les
    # nœuds de ce PC : signatures du dernier bloc, taille du set, âge du dernier bloc.
    local i0=0
    for i in $(seq 1 "$n"); do alive "$i" && { i0=$i; break; }; done
    if (( i0 == 0 )); then echo "  ${c_r}✗ aucun nœud local en marche${c_0}"; return 0; fi
    local h vals sig age bt
    h=$(rpc "$i0" health)
    bt=$(echo "$h" | jget "['block_time_secs']")
    age=$(( $(date +%s) - $(echo "$h" | jget "['tip_timestamp']") ))
    vals=$(rpc "$i0" validators | jget "['count']")
    sig=$(rpc "$i0" "block/$(echo "$h" | jget "['height']")" | jget "['signatures_count']")
    local need=$(( vals * 2 / 3 + 1 ))
    echo "  réseau : ${c_b}$vals validateur(s)${c_0}, il en faut $need pour valider un bloc · dernier bloc certifié par ${sig:-?} signature(s) · il y a ${age}s"
    if (( age <= 3 * ${bt:-12} + 5 )); then
        ok "la chaîne avance"
    else
        echo "  ${c_r}✗ aucun bloc depuis ${age}s — quorum probablement perdu ($need validateurs en ligne nécessaires sur $vals)${c_0}"
    fi
}

cmd_stop() {
    local n; n=$(count)
    for i in $(seq 1 "$n"); do systemctl stop "vinx-node$i" 2>/dev/null || true; done
    for i in $(seq 1 "$n"); do
        local p; p=$(pid_of "$i")
        [[ -n "$p" ]] && kill "$p" 2>/dev/null || true
        rm -f "$HOME_DIR/node$i.pid"
    done
    ok "réseau arrêté (données conservées dans $HOME_DIR)"
}

# Les clés de test sont en clair (réseau local) : on masque l'avertissement correspondant.
wallet_cli() { "$WALLET" "$@" --node "http://127.0.0.1:$(rpc_port 1)" 2> >(grep -v PLAINTEXT >&2); }
atoms() { rpc 1 "account/$1" | jget "['$2']"; }
wait_for() { # secondes message commande…
    local t="$1" m="$2"; shift 2
    printf "  %s" "$m"
    for _ in $(seq 1 "$t"); do if "$@" >/dev/null 2>&1; then echo " ${c_ok}✓${c_0}"; return 0; fi; printf "."; sleep 1; done
    echo; return 1
}
ge() { python3 -c "import sys;sys.exit(0 if int('${1:-0}' or 0)>=int('$2') else 1)"; }
BOND=10000; BOND_ATOMS=10000000000000

cmd_join() {
    local target="${1:?usage : ./vinx join <ip-de-l-hôte>[:port]}" host port
    host="${target%%:*}"; port="${target##*:}"; [[ "$port" == "$target" ]] && port=8545
    build
    if [[ ! -f "$HOME_DIR/joined" ]]; then
        [[ -f "$HOME_DIR/genesis.json" ]] && die "un réseau local existe déjà ici — ./vinx reset d'abord"
        say "Connexion à l'hôte $host:$port"
        mkdir -p "$HOME_DIR/node1"
        curl -sf --max-time 5 "http://$host:$port/chain/genesis" -o "$HOME_DIR/genesis.json" \
            || die "hôte injoignable ou pas lancé avec ./vinx start --lan (http://$host:$port/chain/genesis)"
        echo "$host $port" >"$HOME_DIR/joined"; echo 1 >"$HOME_DIR/validators"; touch "$HOME_DIR/lan"
        CHAIN_ID=$(python3 -c "import json;print(json.load(open('$HOME_DIR/genesis.json'))['chain_id'])")
        "$NODE" --data-dir "$HOME_DIR/node1" --chain-id $CHAIN_ID --genesis-entry 2>/dev/null | grep '^{' >"$HOME_DIR/validator-keys.json"
        ok "genèse récupérée, clés du validateur créées"
    fi
    start_node 1
    wait_up
    local remote_h; remote_h=$(curl -s --max-time 3 "http://$host:$port/health" | jget "['height']")
    wait_for 300 "synchronisation jusqu'au bloc ${remote_h:-?}" \
        bash -c "h=\$(curl -s http://127.0.0.1:$(rpc_port 1)/health | python3 -c 'import sys,json;print(json.load(sys.stdin)[\"height\"])'); [ \"\$h\" -ge ${remote_h:-0} ]" \
        || die "synchronisation trop lente — voir ./vinx logs 1"
    local me; me=$(python3 -c "import json;print(json.load(open('$HOME_DIR/node1/validator.json'))['address'])")
    if [[ "$(rpc 1 validators)" == *"$me"* ]]; then ok "déjà validateur ($me)"; return 0; fi
    # Demande d'admission déposée chez l'hôte (visible avec ./vinx pending).
    curl -s --max-time 5 -X POST -H 'Content-Type: application/json' \
        -d "{\"address\":\"$me\",\"message\":\"$(hostname) via ./vinx join\"}" \
        "http://$host:$port/validators/request" >/dev/null || true
    if ! ge "$(atoms "$me" staked_atoms)" "$BOND_ATOMS"; then
        echo
        echo "  ${c_b}Sur le PC hôte, lancez :${c_0}"
        echo "      ./vinx accept $me"
        echo
        printf "  attente des fonds (%s VINX)" "$((BOND + 1))"
        until ge "$(atoms "$me" balance_atoms)" "$((BOND_ATOMS + 1000000000))"; do printf "."; sleep 2; done
        echo " ${c_ok}✓${c_0}"
        say "Dépôt de la garantie ($BOND VINX) avec la clé de vote BLS"
        (cd "$HOME_DIR" && wallet_cli stake --amount "$BOND" --validator-keys "$HOME_DIR/validator-keys.json" --wallet "$HOME_DIR/node1/validator.json") >/dev/null \
            || die "le dépôt a échoué"
        until ge "$(atoms "$me" staked_atoms)" "$BOND_ATOMS"; do sleep 2; done
        ok "garantie déposée"
    fi
    until [[ "$(rpc 1 validators)" == *"$me"* ]]; do sleep 2; done
    ok "ce PC est maintenant validateur : $me"
    echo "  ${c_dim}La chaîne a besoin de plus des 2/3 des validateurs en ligne : gardez ce PC allumé,${c_0}"
    echo "  ${c_dim}ou l'hôte s'arrêtera aussi. Interface : http://127.0.0.1:$(rpc_port 1)/${c_0}"
}

cmd_accept() {
    local addr="${1:?usage : ./vinx accept <adresse vinx1…>}"
    [[ -f "$HOME_DIR/genesis.json" && ! -f "$HOME_DIR/joined" ]] || die "à lancer sur le PC hôte (celui qui a fait ./vinx start)"
    alive 1 || die "le nœud 1 n'est pas lancé — ./vinx start --lan"
    build
    local admin; admin=$(python3 -c "import json;print(json.load(open('$HOME_DIR/node1/admin.json'))['address'])")
    local bank="$HOME_DIR/node1/validator.json"
    if [[ -z "$(atoms "$admin" nonce)" ]]; then   # le compte admin doit exister pour signer
        wallet_cli transfer --to "$admin" --amount 1 --wallet "$bank" >/dev/null || die "transfert vers l'admin refusé"
        wait_for 120 "création du compte d'administration" bash -c "curl -sf http://127.0.0.1:$(rpc_port 1)/account/$admin"
    fi
    if ! ge "$(atoms "$addr" staked_atoms)" "$BOND_ATOMS"; then
        if ! ge "$(atoms "$addr" balance_atoms)" "$BOND_ATOMS"; then
            wallet_cli transfer --to "$addr" --amount "$((BOND + 1))" --memo "join" --wallet "$bank" >/dev/null || die "envoi des fonds refusé"
            ok "$((BOND + 1)) VINX de test envoyés à $addr"
        fi
        wait_for 1800 "attente du dépôt de garantie par l'autre PC" \
            bash -c "s=\$(curl -s http://127.0.0.1:$(rpc_port 1)/account/$addr | python3 -c 'import sys,json;print(json.load(sys.stdin)[\"staked_atoms\"])'); [ \"\$s\" -ge $BOND_ATOMS ]" \
            || die "pas de dépôt reçu — l'autre PC a-t-il lancé ./vinx join ?"
    fi
    if [[ "$(rpc 1 validators)" != *"$addr"* ]]; then
        wallet_cli add-validator --validator "$addr" --wallet "$HOME_DIR/node1/admin.json" >/dev/null || die "ajout refusé"
        wait_for 120 "ajout au set de validateurs" bash -c "curl -s http://127.0.0.1:$(rpc_port 1)/validators | grep -q $addr"
    fi
    ok "$addr est validateur — $(rpc 1 validators | jget "['count']") validateurs au total"
}

cmd_load() {
    local n="${1:-500}" w="${2:-$HOME_DIR/node1/validator.json}"
    [[ "$n" =~ ^[0-9]+$ ]] || die "usage : ./vinx load [nombre] [portefeuille.json]"
    [[ -f "$w" ]] || die "portefeuille introuvable : $w"
    alive 1 || die "le nœud local n'est pas lancé"
    build
    say "Test de charge : $n transferts"
    wallet_cli load-test --count "$n" --wallet "$w"
}

cmd_pending() {
    [[ -f "$HOME_DIR/node1/config.toml" ]] || die "à lancer sur le PC hôte"
    local tok; tok=$(sed -n 's/^admin_token = "\(.*\)"/\1/p' "$HOME_DIR/node1/config.toml")
    [[ -n "$tok" ]] || die "pas de jeton admin (réseau créé avant cette version : ./vinx reset)"
    local vals; vals=$(rpc 1 validators)
    curl -s -H "Authorization: Bearer $tok" "http://127.0.0.1:$(rpc_port 1)/validators/pending" | VALS="$vals" python3 -c "
import json,sys,os
d=json.load(sys.stdin); seen=set()
known={v['address'] for v in json.loads(os.environ['VALS'] or '{}').get('validators',[])}
r=[x for x in d.get('requests',[]) if x['address'] not in known and not (x['address'] in seen or seen.add(x['address']))]
if not r: print('  aucune demande en attente')
for x in r: print('  ' + x['address'] + '   ' + (x.get('message') or '') + '\n    → ./vinx accept ' + x['address'])"
}

cmd_service() {
    [[ $EUID -eq 0 ]] || die "à lancer en root (sudo ./vinx service)"
    command -v systemctl >/dev/null || die "systemd introuvable"
    [[ -f "$HOME_DIR/genesis.json" ]] || die "créez ou rejoignez d'abord un réseau (./vinx start / ./vinx join)"
    build
    for i in $(seq 1 "$(count)"); do
        node_args "$i"
        local p; p=$(pid_of "$i"); [[ -n "$p" ]] && kill "$p" 2>/dev/null; rm -f "$HOME_DIR/node$i.pid"
        cat >"/etc/systemd/system/vinx-node$i.service" <<EOF
[Unit]
Description=VinX validateur $i
After=network-online.target
Wants=network-online.target

[Service]
Environment=VINX_GENESIS_SPEC=$HOME_DIR/genesis.json
ExecStart=$NODE ${ARGS[*]}
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable --now "vinx-node$i" >/dev/null 2>&1 && ok "service vinx-node$i actif (redémarre tout seul, démarre au boot)"
    done
    echo "  ${c_dim}journal : journalctl -u vinx-node1 -f   ·   arrêt : systemctl stop vinx-node1${c_0}"
}

case "${1:-help}" in
    pending) cmd_pending ;;
    service) cmd_service ;;
    load)   shift; cmd_load "$@" ;;
    join)   shift; cmd_join "$@" ;;
    accept) shift; cmd_accept "$@" ;;
    start)  shift; cmd_start "$@" ;;
    status) cmd_status ;;
    stop)   cmd_stop ;;
    kill)   p=$(pid_of "${2:?numéro du nœud}"); [[ -n "$p" ]] && kill "$p" 2>/dev/null; rm -f "$HOME_DIR/node$2.pid"; ok "nœud $2 arrêté"; cmd_status ;;
    revive) start_node "${2:?numéro du nœud}"; sleep 2; ok "nœud $2 relancé"; cmd_status ;;
    logs)   tail -n 50 -f "$HOME_DIR/node${2:-1}.log" ;;
    wallet) shift; build; cd "$HOME_DIR" && "$WALLET" "$@" ;;
    reset)  cmd_stop >/dev/null 2>&1 || true; rm -rf "$HOME_DIR"; ok "réseau local effacé" ;;
    *)      sed -n '3,/^# ─────/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
esac
